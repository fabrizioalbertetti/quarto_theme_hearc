% Thème Beamer HE-Arc pour les supports de cours.
% Palette et formes alignées sur le logo HE-Arc Ingénierie :
% rouge pur (#FF0000), noir, fond blanc, formes rondes (cercle du « + »).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehearc-ing}[2026/10/28 v1.0 HE-Arc course theme]

\RequirePackage{etoolbox}
\RequirePackage{tikz}

\mode<presentation>

% ---------------------------------------------------------------------------
% Métadonnées du cours (définies par course-meta.lua depuis _quarto.yml)
% ---------------------------------------------------------------------------
\providecommand\hearc@coursename{}
\providecommand\hearc@courseshort{}
\providecommand\hearc@courseclass{}
\providecommand\hearc@footer{}

% « Nom du cours · Classe », sans séparateur orphelin si un champ manque
\newcommand\hearc@courseline[1]{%
  #1%
  \ifboolexpr{not test {\ifdefempty{#1}} and not test {\ifdefempty{\hearc@courseclass}}}%
    {\enspace\textcolor{hearcred}{\textbullet}\enspace}{}%
  \hearc@courseclass}

% ---------------------------------------------------------------------------
% Couleurs (issues du logo)
% ---------------------------------------------------------------------------
\definecolor{hearcred}{HTML}{FF0000}
\definecolor{hearcblack}{HTML}{000000}
\definecolor{hearcgray}{HTML}{6E6E6E}
\definecolor{hearclight}{HTML}{F2F2F2}

\setbeamercolor{normal text}{fg=hearcblack,bg=white}
\setbeamercolor{structure}{fg=hearcred}
\setbeamercolor{alerted text}{fg=hearcred}
\setbeamercolor{example text}{fg=hearcblack}
\setbeamercolor{title}{fg=hearcblack}
\setbeamercolor{subtitle}{fg=hearcred}
\setbeamercolor{author}{fg=hearcblack}
\setbeamercolor{institute}{fg=hearcgray}
\setbeamercolor{date}{fg=hearcgray}
\setbeamercolor{frametitle}{fg=hearcblack}
\setbeamercolor{framesubtitle}{fg=hearcgray}
\setbeamercolor{section title}{fg=hearcblack}
\setbeamercolor{footline}{fg=hearcgray}
\setbeamercolor{block title}{fg=white,bg=hearcblack}
\setbeamercolor{block body}{fg=hearcblack,bg=hearclight}
\setbeamercolor{block title alerted}{fg=white,bg=hearcred}
\setbeamercolor{block body alerted}{fg=hearcblack,bg=hearclight}
\setbeamercolor{block title example}{fg=hearcblack,bg=hearclight}
\setbeamercolor{block body example}{fg=hearcblack,bg=hearclight}

% ---------------------------------------------------------------------------
% Polices
% ---------------------------------------------------------------------------
\setbeamerfont{title}{size=\huge,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize,series=\bfseries}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize}
\setbeamerfont{section title}{size=\huge,series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}

% ---------------------------------------------------------------------------
% Éléments généraux
% ---------------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{sidebar right}{}  % logo uniquement sur la page de titre
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\tikz\fill[hearcred] (0,0) circle (0.42ex);}}
\setbeamertemplate{itemize subitem}{\raisebox{0.2ex}{\tikz\draw[hearcred,line width=0.5pt] (0,0) circle (0.35ex);}}
\setbeamertemplate{itemize subsubitem}{\textcolor{hearcgray}{--}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{blocks}[rounded]
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{caption label separator}{~:~}

% Petite barre rouge, reprise sur les pages de titre, de section et les frames
\newcommand\hearc@bar[1]{{\color{hearcred}\rule{#1}{3pt}}}

% ---------------------------------------------------------------------------
% Page de titre
% ---------------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \raggedright
  \vfill
  \hearc@bar{3em}\par\vskip1.2em
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
  \ifx\insertsubtitle\@empty\else
    \vskip0.5em
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
  \fi
  \vskip2em
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
  {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
  \vskip0.8em
  {\usebeamerfont{date}\usebeamercolor[fg]{date}%
    \hearc@courseline{\hearc@coursename}\par
    \insertdate\par}
  \vfill
  \hfill\insertlogo\par
}

% ---------------------------------------------------------------------------
% Page de section (générée par chaque titre « # » du .qmd)
% ---------------------------------------------------------------------------
\setbeamertemplate{section page}{%
  \raggedright
  \vfill
  \hearc@bar{3em}\par\vskip1.2em
  {\usebeamerfont{section title}\usebeamercolor[fg]{section title}\insertsectionhead\par}
  \vfill
}

% ---------------------------------------------------------------------------
% Titre des frames
% ---------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vskip0.9em
  \hearc@bar{1.6em}\par\vskip0.35em
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}
  \ifx\insertframesubtitle\@empty\else
    {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}
  \fi
  \vskip0.2em
}

% ---------------------------------------------------------------------------
% Pied de page : texte libre (course.footer) | cours · classe | numéro (masqué sur la page de titre)
% ---------------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \ifnum\value{framenumber}=1\else
  \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
  \hbox to \paperwidth{%
    \hskip1.2em
    \parbox[b][2.6ex][t]{0.3\paperwidth}{\raggedright\hearc@footer}%
    \hfill
    \parbox[b][2.6ex][t]{0.4\paperwidth}{\centering\hearc@courseline{\hearc@courseshort}}%
    \hfill
    \parbox[b][2.6ex][t]{0.2\paperwidth}{\raggedleft
      \textcolor{hearcred}{\textbf{\insertframenumber}}\,/\,\inserttotalframenumber}%
    \hskip1.2em}%
  \vskip0.6em
  \fi
}

\mode<all>
